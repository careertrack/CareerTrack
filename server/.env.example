# Local Postgres, or paste Render's External Database URL when pointing at hosted DB.
DATABASE_URL=postgresql://postgres:password@localhost:5432/careertrack
# Set true on Render. Leave unset for local Postgres.
DATABASE_SSL=false
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PORT=3001
NODE_ENV=development
DATABASE_MAX_CLIENTS=10
